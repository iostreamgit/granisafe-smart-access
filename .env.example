# Granisafe Smart Access — environment template
# Copy to .env and adjust values. Never commit .env.

# --- Apps ---
API_PORT=3000
WEB_PORT=8080
AI_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=

# --- PostgreSQL ---
POSTGRES_USER=granisafe
POSTGRES_PASSWORD=granisafe
POSTGRES_DB=granisafe_smart_access
POSTGRES_PORT=5433
DATABASE_URL=postgresql://granisafe:granisafe@localhost:5433/granisafe_smart_access

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=granisafe-evidence
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Auth (Phase 2+) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
SEED_PASSWORD=Password123!

# --- AI service ---
# fake = in-process FakeAiAdapter | http = HttpAiAdapter → AI_BASE_URL
AI_ADAPTER=http
AI_BASE_URL=http://localhost:8000
AI_API_KEY=dev-ai-key-change-me
AI_TIMEOUT_MS=30000
# Force DENIED with AI_UNAVAILABLE (ops kill switch)
AI_KILL_SWITCH=false
MODEL_PATH=./models/ppe-yolo.pt
MODEL_VERSION=best-ppe-yolo
DEVICE=cpu

# Stage-2 vest classifier (torso crop → vest_worn / no_vest)
VEST_CLASSIFIER_ENABLED=false
VEST_CLASSIFIER_PATH=./models/vest-classifier.pt
VEST_CLASSIFIER_MIN_CONFIDENCE=0.75
VEST_TEMPORAL_WINDOW=5
VEST_TEMPORAL_SESSION_TTL_SEC=120
VEST_FEEDBACK_ENABLED=true
VEST_MISTAKES_DIR=./datasets/vest-classifier/mistakes

# --- Access defaults ---
GATE_OPEN_MS=3000
LOG_LEVEL=info
