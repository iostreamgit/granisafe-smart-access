{
  "name": "@granisafe/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "node -e \"const fs=require('fs'); for (const p of ['dist','tsconfig.build.tsbuildinfo','tsconfig.tsbuildinfo']) { try { fs.rmSync(p,{recursive:true,force:true}); } catch {} }\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/modules/attendance/late.util.spec.ts src/modules/access-control/decision.service.spec.ts src/modules/access-control/adapters/http-ai.adapter.spec.ts src/modules/auth/authz.matrix.spec.ts src/shared/upload/upload.limits.spec.ts",
    "test:integration": "tsx --test src/test/postgres.integration.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node ./scripts/with-env.mjs -- npx prisma migrate dev",
    "prisma:deploy": "node ./scripts/with-env.mjs -- npx prisma migrate deploy",
    "prisma:seed": "node ./scripts/with-env.mjs -- npx prisma db seed",
    "db:setup": "node ./scripts/with-env.mjs -- npx prisma migrate deploy && node ./scripts/with-env.mjs -- npx prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@granisafe/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.5.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
